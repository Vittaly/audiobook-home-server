# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# --- Moshi codegen (R8) ---
# Сгенерированные Moshi-адаптеры находятся по рефлексии (Class.forName).
# Несмотря на явную регистрацию в ApiProvider, держим их и DTO, чтобы
# release-сборка с обфускацией никогда не потеряла адаптеры.
-keep class ru.burkut.audiobooks.data.api.**JsonAdapter {
    public <init>(com.squareup.moshi.Moshi);
}

# DTO, которые сериализуются сгенерированными адаптерами.
-keepnames class ru.burkut.audiobooks.data.api.* {
    <init>(...);
    *;
}

# Имена полей enum'ов используются EnumJsonAdapter.
-keepclassmembers,allowoptimization class ru.burkut.audiobooks.data.api.** {
    **[] values();
    <fields>;
}