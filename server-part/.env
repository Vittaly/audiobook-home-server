DATA_DIR=data
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=DEBUG

TTL_DAYS=14
SCRAPE_INTERVAL_HOURS=6
LIBTORRENT_PORT=6881
COVER_MAX_BYTES=10485760
MIN_FREE_DISK_MB=2048

# Торрент-клиент (единый источник режима): qbittorrent | transmission | libtorrent
TORRENT_BACKEND=qbittorrent

# qBittorrent (для TORRENT_BACKEND=qbittorrent)
QBITTORRENT_HOST=127.0.0.1
QBITTORRENT_PORT=8089
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin
QBITTORRENT_AUTOSTART=true

RUTOR_BASE_URL=https://rutor.info
RUTOR_CATEGORY_PATH=/browse/2/0/0/0

MDNS_ENABLED=true
MDNS_SERVICE_TYPE=_audiobook._tcp.local.
MDNS_HEARTBEAT_SEC=300
MDNS_LOCAL_IP=                   # пусто = автоопределение, или явный IP


COVER_SEARCH_ENABLED=true
COVER_SEARCH_TIMEOUT=10.0
COVER_SEARCH_MIN_WIDTH=300
