# ============================================================
# AUDIOBOOK-SERVER — рабочая конфигурация
# ============================================================

# ----------------------- данные -----------------------
# Для выноса БД и загрузок на отдельный диск задайте абсолютный путь:
#   Linux:   DATA_DIR=/mnt/storage/audiobook-data
#   Windows: DATA_DIR=D:\audiobook-data
# Папка создаётся автоматически при первом запуске.
DATA_DIR=/media/77f0/audiobooks_data

# ----------------------- API -----------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# ----------------------- хранение / очистка -----------------------
TTL_DAYS=14
SCRAPE_INTERVAL_HOURS=6
LIBTORRENT_PORT=6881
COVER_MAX_BYTES=10485760
MIN_FREE_DISK_MB=2048

# Торрент-клиент (единый источник режима): qbittorrent | transmission | libtorrent
TORRENT_BACKEND=qbittorrent

# qBittorrent (для TORRENT_BACKEND=qbittorrent)
QBITTORRENT_HOST=127.0.0.1
QBITTORRENT_PORT=8089
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin
QBITTORRENT_AUTOSTART=true

# ----------------------- скрапер -----------------------
RUTOR_BASE_URL=https://rutor.info
RUTOR_CATEGORY_PATH=/browse/2/0/0/0

# ----------------------- mDNS -----------------------
MDNS_ENABLED=true
MDNS_SERVICE_TYPE=_audiobook._tcp.local.
MDNS_HEARTBEAT_SEC=300
MDNS_LOCAL_IP=                   # пусто = автоопределение, или явный IP

# ----------------------- торрент-клиент -----------------------
# Единый источник режима: qbittorrent | transmission | libtorrent
TORRENT_BACKEND=qbittorrent

# --- qBittorrent (headless qbittorrent-nox на Linux) ---
QBITTORRENT_HOST=127.0.0.1
QBITTORRENT_PORT=8080
QBITTORRENT_USER=                # пусто = без аутентификации (LocalHostAuth=false)
QBITTORRENT_PASSWORD=            # пусто = без аутентификации (LocalHostAuth=false)
QBITTORRENT_AUTOSTART=true
QBITTORRENT_BIN=                 # пусто = автопоиск (qbittorrent-nox)
QBITTORRENT_START_TIMEOUT_SEC=30

# --- Transmission ---
TRANSMISSION_HOST=127.0.0.1
TRANSMISSION_PORT=9091
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
TRANSMISSION_POLL_SEC=5
TRANSMISSION_AUTOSTART=false
TRANSMISSION_BIN=
TRANSMISSION_CONFIG_DIR=
TRANSMISSION_START_TIMEOUT_SEC=30

# ----------------------- поиск обложек -----------------------
COVER_SEARCH_ENABLED=true
COVER_SEARCH_TIMEOUT=10.0
COVER_SEARCH_MIN_WIDTH=300
