# ============================================================
# AUDIOBOOK-SERVER — пример конфигурации.
# Скопируйте в .env и отредактируйте под себя:
#   cp .env.example .env
# ============================================================

# ----------------------- данные -----------------------
# Папка со всеми данными: БД (app.sqlite), загрузки (downloads/),
# обложки (covers/), логи (app.log), tmp/.
# Относительный путь считается от корня проекта; абсолютный —
# используется как есть (удобно для отдельного диска):
#   Linux:   DATA_DIR=/mnt/storage/audiobook-data
#   Windows: DATA_DIR=D:\audiobook-data
# Папка создаётся автоматически при первом запуске.
DATA_DIR=data

# SQLite-VFS. Для DATA_DIR на сетевой ФС (CIFS/SMB) обычный VFS "unix"
# не работает: CIFS не поддерживает POSIX-локи, SQLite падает с
# "database is locked". "unix-excl" держит один блокирующий дескриптор
# на файле БД и WAL-индекс в памяти процесса — на шаре не появляются
# ни -wal, ни -shm. Для локального диска можно оставить "" (системный VFS).
#   SQLITE_VFS=unix-excl
SQLITE_VFS=unix-excl

# ----------------------- API -----------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# ----------------------- хранение / очистка -----------------------
TTL_DAYS=14            # дней без использования до автоудаления книги
SCRAPE_INTERVAL_HOURS=6
LIBTORRENT_PORT=6881
COVER_MAX_BYTES=10485760
MIN_FREE_DISK_MB=2048

# ----------------------- скрапер -----------------------
RUTOR_BASE_URL=https://rutor.info
RUTOR_CATEGORY_PATH=/browse/2/0/0/0

# ----------------------- mDNS -----------------------
MDNS_ENABLED=true
MDNS_SERVICE_TYPE=_audiobook._tcp.local.
MDNS_HEARTBEAT_SEC=300
MDNS_LOCAL_IP=                  # пусто = автоопределение, или явный IP

# ----------------------- торрент-клиент -----------------------
# Единый источник режима: qbittorrent | transmission | libtorrent
# headless Linux:  qbittorrent (qbittorrent-nox) или transmission
# Windows:         qbittorrent (GUI) или transmission
TORRENT_BACKEND=qbittorrent

# --- qBittorrent ---
QBITTORRENT_HOST=127.0.0.1
QBITTORRENT_PORT=8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin

# qBittorrent daemon (автозапуск, если клиент ещё не запущен)
QBITTORRENT_AUTOSTART=true
QBITTORRENT_BIN=            # путь к qbittorrent-nox / qbittorrent.exe (пусто = автопоиск)
QBITTORRENT_START_TIMEOUT_SEC=30

# --- Transmission ---
TRANSMISSION_HOST=127.0.0.1
TRANSMISSION_PORT=9091
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
TRANSMISSION_POLL_SEC=5

# Transmission daemon (автозапуск). На headless Linux укажите
# transmission-daemon через TRANSMISSION_BIN или оставьте пустым =
# автопоиск по ОС.
TRANSMISSION_AUTOSTART=false
TRANSMISSION_BIN=
TRANSMISSION_CONFIG_DIR=
TRANSMISSION_START_TIMEOUT_SEC=30

# ----------------------- поиск обложек -----------------------
COVER_SEARCH_ENABLED=true
COVER_SEARCH_TIMEOUT=10.0
COVER_SEARCH_MIN_WIDTH=300
