# ============================================================
# Audiobook Home Server — systemd unit (Linux, headless)
# ============================================================
#
# ЭТО ШАБЛОН. Не копируйте его в /etc/systemd/system вручную:
# пути __USER__ / __HOME__ / __WORKDIR__ / __PYTHON__ подставляет
# ./manage.sh install (по текущему пользователю и venv проекта).
#
# УСТАНОВКА:
#   ./manage.sh install        # отрендерит шаблон и положит в /etc/systemd/system
#   ./manage.sh auto           # install + enable --now (автозапуск)
#
# Ручная установка (если нужно):
#   sed -e "s|__USER__|$USER|g" \
#       -e "s|__HOME__|$HOME|g" \
#       -e "s|__WORKDIR__|$(pwd)|g" \
#       -e "s|__PYTHON__|$(pwd)/.venv/bin/python3|g" \
#       deploy/audiobook-server.service | sudo tee /etc/systemd/system/audiobook-server.service >/dev/null
#   sudo systemctl daemon-reload
#
# ВАЖНО: .env сервер читает сам из WorkingDirectory (pydantic-settings),
# поэтому EnvironmentFile не нужен — он конфликтует с inline-комментариями
# в .env (systemd не умеет inline-комментарии, а мы их используем).
#
# Торрент-клиент (qbittorrent-nox / transmission-daemon) сервер поднимает
# сам через QBITTORRENT_AUTOSTART / TRANSMISSION_AUTOSTART, если он ещё
# не запущен внешним systemd-юнитом.

[Unit]
Description=Audiobook Home Server
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__

# каталог с main.py и .env
WorkingDirectory=__WORKDIR__

# Путь к Python (venv проекта). Если venv нет — подставьте /usr/bin/python3
ExecStart=__PYTHON__ main.py

Restart=always
RestartSec=10

# мягкое и жёсткое завершение (uvicorn ловит SIGTERM)
TimeoutStopSec=30
KillSignal=SIGTERM

# безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
